# ============================================================
# Programmers Lab — .gitignore
# ============================================================

# Sensitive config — NEVER commit (contains DB credentials)
config.php

# Uploaded user files — runtime data, not source code
uploads/*
!uploads/.htaccess

# Error logs — runtime data
logs/*
!logs/.htaccess
!logs/.gitkeep

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.qoder/

# PHP temp / cache
*.cache
*.tmp

# XAMPP / local server files
*.log
